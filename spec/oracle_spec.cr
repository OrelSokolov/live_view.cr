# Oracle mirror spec: replays the wire transcript recorded from the
# real Phoenix LiveView 1.2.12 (oracle/expected.yml, regenerated by
# oracle/app's `mix test`) against our implementation.
#
# Exact-frame cases (bad join, heartbeat) must match the reply byte for
# byte (after topic masking). Render cases are checked semantically:
# our rendered/diff trees must reconstruct the same DOM as Phoenix did —
# template segmentation may differ, the produced HTML may not.

require "spec"
require "http/server"
require "http/web_socket"
require "../src/live_view_cr"
require "./views"

ORACLE = File.read("#{__DIR__}/../oracle/expected.yml")

def oracle_cases : Hash(String, JSON::Any)
  cases = {} of String => JSON::Any
  ORACLE.each_line do |line|
    next if line.strip.empty?
    name, payload = line.split('\t', 2)
    cases[name] = JSON.parse(payload)
  end
  cases
end

# --- client-side rendered tree (mirror of the transcript recorder) -------

class ClientTree
  property statics : Array(String)
  property dynamics : Hash(String, String)

  def self.from_rendered(rendered : JSON::Any) : ClientTree
    template = rendered["p"]? || JSON::Any.new({} of String => JSON::Any)
    statics = (template[rendered["s"].to_s]? || JSON::Any.new([] of JSON::Any))
      .as_a.map &.as_s

    dynamics = {} of String => String
    rendered.as_h.each do |key, value|
      next if {"p", "s", "r", "t", "e", "c"}.includes?(key)
      dynamics[key] = value.as_s unless value.raw.nil?
    end

    new(statics, dynamics)
  end

  def initialize(@statics, @dynamics)
  end

  def apply_diff(diff : JSON::Any) : Nil
    diff.as_h.each do |key, value|
      next if {"s", "p"}.includes?(key)
      @dynamics[key] = value.as_s unless value.raw.nil?
    end
  end

  def to_html : String
    String.build do |io|
      @statics.each_with_index do |stat, i|
        io << stat
        io << (@dynamics[i.to_s]? || "")
      end
    end
  end
end

describe "oracle transcript" do
  it "replays against live_view_cr" do
    cases = oracle_cases

    socket = LiveView::Socket.new("oracle_secret")
    http = HTTP::Server.new([socket])
    address = http.bind_tcp("127.0.0.1", 0)
    spawn { http.listen }
    Fiber.yield

    ws = HTTP::WebSocket.new("127.0.0.1", "/live/websocket?vsn=2.0.0", address.port)
    frames = Channel(JSON::Any).new(64)
    ws.on_message { |message| frames.send(JSON.parse(message)) }
    spawn { ws.run }
    Fiber.yield

    counter_token = socket.token.sign({
      id:      "phx-counter0",
      view:    "CounterLive",
      session: {} of String => String,
    })
    timer_token = socket.token.sign({
      id:      "phx-timer0",
      view:    "TimerLive",
      session: {} of String => String,
    })

    send_req = ->(name : String, view : String, id : String, token : String) do
      req = cases[name]["req"]
      payload = req[4]
      payload.as_h["session"] = JSON::Any.new(token)
      frame = [req[0], req[1], JSON::Any.new("lv:#{id}"), req[3], payload]
      ws.send(frame.to_json)
    end

    recv = ->do
      select
        when msg = frames.receive
          msg
        when timeout(3.seconds)
          nil
      end
    end

    # mask our topic the way the oracle transcript does
    normalize = ->(rep : JSON::Any) do
      JSON.parse(rep.to_json.sub("lv:phx-counter0x", "lv:<ID>")
        .sub("lv:phx-counter0", "lv:<ID>").sub("lv:phx-timer0", "lv:<ID>"))
    end

    tree = ClientTree.new([] of String, {} of String => String)

    # -- bad join: exact frame match
    send_req.call("bad_join_reply", "CounterLive", "phx-counter0x", "bogus.token")
    ours = normalize.call(recv.call.not_nil!)
    ours.should eq(cases["bad_join_reply"]["rep"])

    # -- join: same reply shape, same DOM
    send_req.call("counter_join_reply", "CounterLive", "phx-counter0", counter_token)
    ours = normalize.call(recv.call.not_nil!)
    oracle_rep = cases["counter_join_reply"]["rep"]
    ours[4]["status"].should eq("ok")
    ours[4]["response"]["liveview_version"].should eq(oracle_rep[4]["response"]["liveview_version"])
    rendered = ours[4]["response"]["rendered"]
    rendered["r"].should eq(JSON::Any.new(1))
    rendered["s"].should eq(JSON::Any.new(0))
    tree = ClientTree.from_rendered(rendered)
    tree.to_html.should eq(cases["counter_join_reply"]["html"].as_s)

    # -- events: apply our diff, DOM must match the oracle snapshot
    {"counter_click_incr_reply", "counter_click_incr_again_reply",
     "counter_click_decr_reply", "counter_form_save_reply"}.each do |name|
      send_req.call(name, "CounterLive", "phx-counter0", counter_token)
      ours = normalize.call(recv.call.not_nil!)
      ours[4]["status"].should eq("ok")
      tree.apply_diff(ours[4]["response"]["diff"])
      tree.to_html.should eq(cases[name]["html"].as_s)
    end

    # -- heartbeat: exact frame match
    ws.send(cases["heartbeat_reply"]["req"].to_json)
    ours = recv.call.not_nil!
    ours.should eq(cases["heartbeat_reply"]["rep"])

    # -- timer: join → two pushed diffs, DOM matches snapshots
    send_req.call("timer_join_reply", "TimerLive", "phx-timer0", timer_token)
    ours = normalize.call(recv.call.not_nil!)
    ours[4]["status"].should eq("ok")
    timer_tree = ClientTree.from_rendered(ours[4]["response"]["rendered"])
    timer_tree.to_html.should eq(cases["timer_join_reply"]["html"].as_s)

    tick1 = normalize.call(recv.call.not_nil!)
    tick1[3].should eq("diff")
    timer_tree.apply_diff(tick1[4])
    timer_tree.to_html.should eq(cases["timer_tick1_diff"]["html"].as_s)

    tick2 = normalize.call(recv.call.not_nil!)
    tick2[3].should eq("diff")
    timer_tree.apply_diff(tick2[4])
    timer_tree.to_html.should eq(cases["timer_tick2_diff"]["html"].as_s)
  end
end
